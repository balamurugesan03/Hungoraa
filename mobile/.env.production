# Used for production EAS builds, e.g.:
#   eas build --profile production --env-file .env.production
# EXPO_PUBLIC_* vars are bundled into the client, so it's fine to commit this file
# (unlike mobile/.env, which points at your local dev machine and stays gitignored).
EXPO_PUBLIC_API_URL=https://hungora.com/api
# Google Cloud Console -> Credentials -> the "Web application" OAuth client ID
# (not the Android one). Must match backend GOOGLE_CLIENT_ID exactly.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
